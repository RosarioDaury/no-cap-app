APP_NAME=NoCap API
ENV=development
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://127.0.0.1:8081
DATABASE_URL=sqlite:///./nocap.db
# HS256 signing key for access tokens. Change in production.
JWT_SECRET=dev-only-change-me
# Fernet key material for email / gender / date of birth at rest. Keep stable.
PII_KEY=dev-only-pii-key-change-me
JWT_EXPIRE_MINUTES=20160
# Optional. When empty, chat uses a deterministic snapshot summary (no tokens).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
SNAPSHOT_MAX_BYTES=8192
