# Copy to .env for local Expo (`npm start` from mobile/).
# Do not put secrets here — EXPO_PUBLIC_ values are inlined into the JS bundle.
#
# Local:
#   iOS Simulator / web  http://127.0.0.1:8000
#   Android emulator     http://10.0.2.2:8000
#   Physical device      http://YOUR_LAN_IP:8000
# Deployed API:
#   https://no-cap-app-production.up.railway.app
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
