{
  "expo": {
    "name": "NoCap",
    "slug": "nocap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/lid-off/app-icon-1024.png",
    "scheme": "nocap",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nocap.budget",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#161826",
        "foregroundImage": "./assets/images/lid-off/app-icon-maskable-512.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.nocap.budget"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/lid-off/favicon-32.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/lid-off/mark-512-transparent.png",
          "imageWidth": 128,
          "backgroundColor": "#161826"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e9237cd0-5bdb-47d7-99d6-b97e5ad60f82"
      }
    }
  }
}
