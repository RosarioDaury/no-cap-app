{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Postgres",
      "type": "shell",
      "command": "docker compose up",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "nocap-postgres",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "database system is ready to accept connections"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "nocap",
        "focus": false
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Backend",
      "type": "shell",
      "command": ".venv/bin/fastapi",
      "args": ["dev"],
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "PYTHONUNBUFFERED": "1"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "nocap-backend",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Uvicorn running on"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "nocap",
        "focus": false
      },
      "dependsOn": ["Postgres"],
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Mobile",
      "type": "npm",
      "script": "start",
      "path": "mobile/",
      "isBackground": true,
      "problemMatcher": {
        "owner": "nocap-mobile",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Waiting on|Metro waiting on"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "nocap",
        "focus": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Start NoCap",
      "dependsOn": ["Backend", "Mobile"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "nocap"
      }
    }
  ]
}
